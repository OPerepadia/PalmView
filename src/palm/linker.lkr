/* Based on PalmTLS apps/tls-tester/toolchain/linker.lkr.
 *
 * The code is split into two resources, code 1 and code 2, each under
 * 65000 bytes. Whole files go into one segment: a file reaches its own
 * strings and tables PC-relatively. Calls between files go through veneers
 * (tools/m68k-veneers.py), so only each file must stay under 32 KB. The
 * startup code relocates absolute addresses using the table that
 * tools/m68k-relocs.py builds from this link. */

MEMORY
{
    main : ORIGIN = 0x10000000, LENGTH = 65000
    main2 : ORIGIN = 0x20000000, LENGTH = 65000
    trash : ORIGIN = 0x40000000, LENGTH = 64K
}

SECTIONS
{
    .macsbug_discard : { *(.text.*.macsbug) } > trash
    .vec : { KEEP(*(.vectors)) *(.vectors) } > main
    .text2 : {
        *mp4_merge.o(.text .text.* .rodata .rodata.*)
        *yt_api.o(.text .text.* .rodata .rodata.*)
        *json_scan.o(.text .text.* .rodata .rodata.*)
        *thumb.o(.text .text.* .rodata .rodata.*)
        *player.o(.text .text.* .rodata .rodata.*)
        *tjpgd.o(.text .text.* .rodata .rodata.*)
        . = ALIGN(4);
    } > main2
    .text : {
        *startup.o(.text .text.* .rodata .rodata.*)
        *(.text .text.* .rodata .rodata.*)
        . = ALIGN(4);
    } > main
    .trash2 : { *(.init) *(.init.*) *(.fini) *(.fini.*) *(*.macsbug) } > trash
    /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) *(.data*) *(.bss*) *(COMMON) }
}

ENTRY(__Startup__)
