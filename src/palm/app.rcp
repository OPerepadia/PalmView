#include "resource.h"

DATA "code" ID 1 "code0001.bin"
DATA "code" ID 2 "code0002.bin"
DATA "Rloc" ID 1 "relocs.bin"
// Google Trust Services WR2 + WE2 issuers (tools/update-certs.sh).
DATA "cert" ID TrustCertificates "../../certs/google.pem"
DATA "Tjis" ID JisTable "jis.bin"
// SysAppPrefsType: priority 30, 32 KiB stack, 4 KiB minimum free heap.
HEX "pref" ID 0 0x00 0x1e 0x00 0x00 0x80 0x00 0x00 0x00 0x10 0x00

FORM ID MainForm AT (0 0 160 160)
MENUID MainMenuBar
BEGIN
    TITLE "PalmView"
    // As wide as the label, so the text ends at the right edge
    BUTTON "Downloads" ID SavedButton AT (RIGHT@159 1 43 11) NOFRAME
    FIELD ID SearchField AT (2 17 105 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 63
    POPUPTRIGGER "" ID HistoryTrigger AT (109 17 12 12) LEFTANCHOR
    LIST "" ID HistoryList AT (2 30 156 AUTO) NONUSABLE VISIBLEITEMS 8
    POPUPLIST ID HistoryTrigger HistoryList
    BUTTON "Search" ID SearchButton AT (123 16 35 12)
    GADGET ID ResultGadget AT (0 31 153 115)
    SCROLLBAR ID ResultScrollBar AT (153 31 7 115) VALUE 0 MIN 0 MAX 0 PAGESIZE 3
    FIELD ID StatusField AT (2 146 140 12) NONEDITABLE SINGLELINE MAXCHARS 79
    GRAFFITISTATEINDICATOR AT (148 147)
END

FORM ID DetailForm AT (0 0 160 160)
BEGIN
    TITLE "Video Details"
    GADGET ID ThumbGadget AT (2 16 60 34)
    FIELD ID HeadField AT (65 16 93 33) NONEDITABLE MULTIPLELINES MAXCHARS 143
    FIELD ID InfoField AT (2 53 148 33) NONEDITABLE MULTIPLELINES MAXCHARS 383
    SCROLLBAR ID InfoScrollBar AT (152 53 7 33) VALUE 0 MIN 0 MAX 0 PAGESIZE 3
    FIELD ID ProgressField AT (2 94 156 34) NONEDITABLE MULTIPLELINES MAXCHARS 191
    GADGET ID ProgressGadget AT (2 131 156 8)
    BUTTON "Play" ID PlayButton AT (2 145 40 12)
    BUTTON "Download" ID DownloadButton AT (46 145 50 12)
    BUTTON "Cancel" ID CancelButton AT (2 145 40 12)
    BUTTON "Back" ID BackButton AT (118 145 40 12)
    POPUPTRIGGER "144p" ID DetailQualityTrigger AT (RIGHT@159 1 AUTO 11) RIGHTANCHOR NONUSABLE
    LIST "144p" "240p" ID DetailQualityList AT (RIGHT@159 1 30 AUTO) VISIBLEITEMS 2 NONUSABLE
    POPUPLIST ID DetailQualityTrigger DetailQualityList
END

FORM ID SavedForm AT (0 0 160 160)
BEGIN
    TITLE "Downloads"
    LIST "" ID SavedList AT (0 16 160 110) VISIBLEITEMS 10
    FIELD ID SavedInfoField AT (2 130 156 12) NONEDITABLE SINGLELINE MAXCHARS 31 NONUSABLE
    FIELD ID SavedStatusField AT (2 146 112 12) NONEDITABLE SINGLELINE MAXCHARS 47
    BUTTON "Play" ID SavedPlayButton AT (2 145 40 12) NONUSABLE
    BUTTON "Delete" ID SavedDeleteButton AT (46 145 40 12) NONUSABLE
    BUTTON "Back" ID SavedBackButton AT (118 145 40 12)
END

// The ARM decoder draws into the gadget's area of the screen directly.
FORM ID PlayForm AT (0 0 160 160)
BEGIN
    TITLE "Video"
    POPUPTRIGGER "144p" ID PlayQualityTrigger AT (RIGHT@159 1 AUTO 11) RIGHTANCHOR NONUSABLE
    LIST "144p" "240p" ID PlayQualityList AT (RIGHT@159 1 30 AUTO) VISIBLEITEMS 2 NONUSABLE
    POPUPLIST ID PlayQualityTrigger PlayQualityList
    GADGET ID PlayVideoGadget AT (0 16 160 90)
    GADGET ID PlaySeekGadget AT (2 106 156 5)
    FIELD ID PlayStatusField AT (2 111 156 33) NONEDITABLE MULTIPLELINES MAXCHARS 127
    BUTTON "Pause" ID PlayPauseButton AT (2 145 40 12)
    GADGET ID PlayVolumeGadget AT (55 147 50 9)
    BUTTON "Back" ID PlayBackButton AT (118 145 40 12)
END

// Full screen: the ARM decoder draws the picture turned, over all of it.
FORM ID FullForm AT (0 0 160 160) NOFRAME
BEGIN
END

MENU ID MainMenuBar
BEGIN
    PULLDOWN "Options"
    BEGIN
        MENUITEM "Clear Search History" ID MenuClearHistory
        MENUITEM "Reset YouTube ID" ID MenuResetVisitor
        MENUITEM "About PalmView" ID MenuAbout
    END
END

ALERT ID AboutAlert
INFORMATION
BEGIN
    TITLE "PalmView"
    MESSAGE "Version @APP_VERSION@\n144p YouTube for Palm OS.\nVideos are saved to /PalmView on the card. Play them here or in CorePlayer.\nGPL-3.0-or-later. Uses PalmTLS and FFmpeg."
    BUTTONS "OK"
END

ALERT ID LibraryMissingAlert
ERROR
BEGIN
    TITLE "PalmTLS Required"
    MESSAGE "Install PalmTLSArm.prc in handheld memory, then try again. Error: ^1"
    BUTTONS "OK"
END

ALERT ID DeleteVideoAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
    TITLE "Delete Video"
    MESSAGE "Delete ^1 from the card?"
    BUTTONS "Delete" "Cancel"
END

ALERT ID RomIncompatibleAlert
ERROR
BEGIN
    TITLE "Palm OS 5 Required"
    MESSAGE "PalmView needs Palm OS 5 and a memory card."
    BUTTONS "OK"
END

ICONFAMILYEX ID AppIcon
BEGIN
    BITMAP "icon-color.bmp" BPP 8 TRANSPARENT 255 0 255
    BITMAP "icon-color-hd.bmp" BPP 8 DENSITY 144 TRANSPARENT 255 0 255
END
APPLICATIONICONNAME ID 1000 "PalmView"
VERSION ID AppVersionString "@APP_VERSION@"
STRING ID AppVersionString "@APP_VERSION@"
